    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-900 py-6 text-center text-xs text-gray-600">
        <p>© 2026 CogniMatrix • Avaliação Psicométrica. Todos os direitos reservados.</p>
    </footer>

    <!-- App Logic Script -->
    <script>
        // --- QUIZ QUESTIONS DATA ---
        const questions = [
            {
                category: "Raciocínio Lógico & Sequências",
                question: "Qual é o próximo número na sequência: 2, 6, 12, 20, 30, ...?",
                visual: "2 ➔ 6 ➔ 12 ➔ 20 ➔ 30 ➔ [ ? ]",
                options: ["38", "42", "40", "46"],
                correct: 1,
                explanation: "Diferença entre termos cresce de 2 em 2: +4, +6, +8, +10, portanto o próximo incremento é +12 (30 + 12 = 42)."
            },
            {
                category: "Analogias Verbais",
                question: "ÁGUA está para SEDE assim como ALIMENTO está para:",
                visual: null,
                options: ["Nutrição", "Fome", "Sabor", "Boca"],
                correct: 1,
                explanation: "A água extingue a sede assim como o alimento extingue a fome (relação causa e alívio de necessidade física)."
            },
            {
                category: "Matrizes numéricas",
                question: "Descubra o número faltante na terceira linha:",
                visual: "Linha 1: [3] [7] ➔ 21\nLinha 2: [4] [8] ➔ 32\nLinha 3: [5] [9] ➔ [ ? ]",
                options: ["40", "45", "50", "54"],
                correct: 1,
                explanation: "A regra da matriz é a multiplicação dos dois elementos da linha: 5 × 9 = 45."
            },
            {
                category: "Raciocínio Dedutivo",
                question: "Todos os cães são mamíferos. Todos os mamíferos possuem coração. Logo:",
                visual: null,
                options: [
                    "Todos os cães possuem coração",
                    "Alguns mamíferos não são cães",
                    "Todos os animais com coração são cães",
                    "Nenhuma das opções anteriores"
                ],
                correct: 0,
                explanation: "Por transitividade lógica: Se A⊂B e B⊂C, obrigatoriamente A⊂C."
            },
            {
                category: "Padrões Abstratos",
                question: "Se 3 gatos capturam 3 ratos em 3 minutos, quantos minutos 100 gatos levam para capturar 100 ratos?",
                visual: null,
                options: ["100 minutos", "30 minutos", "3 minutos", "1 minuto"],
                correct: 2,
                explanation: "Cada gato leva exatamente 3 minutos para capturar 1 rato. Em paralelo, 100 gatos capturam 100 ratos nos mesmos 3 minutos."
            },
            {
                category: "Lógica Sequencial",
                question: "Complete a sequência de letras: A, C, F, J, O, ...",
                visual: "A (+2) C (+3) F (+4) J (+5) O (+6) [ ? ]",
                options: ["S", "T", "U", "V"],
                correct: 2,
                explanation: "Os saltos no alfabeto aumentam de 1 em 1: +2, +3, +4, +5, +6. A partir de 'O' (+15), somando 6 letras chegamos a 'U' (21ª letra)."
            },
            {
                category: "Visualização Espacial",
                question: "Um cubo perfeito de madeira azul é cortado em 27 cubos menores idênticos. Quantos cubinhos possuem tinta em exatamente 3 faces?",
                visual: null,
                options: ["6", "8", "12", "1"],
                correct: 1,
                explanation: "Apenas os 8 cubos que ficam localizados exatamente nos vértices (cantos) do cubo maior possuem 3 faces expostas."
            },
            {
                category: "Dedução Lógica",
                question: "Se o amanhã de ontem era sexta-feira, que dia será o ontem de amanhã?",
                visual: null,
                options: ["Quinta-feira", "Sexta-feira", "Sábado", "Domingo"],
                correct: 1,
                explanation: "'Amanhã de ontem' = Hoje (Sexta-feira). 'Ontem de amanhã' = Hoje (Sexta-feira)."
            },
            {
                category: "Raciocínio Matemático",
                question: "Qual número é a metade da metade de um quarto de 160?",
                visual: null,
                options: ["5", "10", "20", "40"],
                correct: 0,
                explanation: "Um quarto de 160 é 40. A metade de 40 é 20. A metade de 20 é 5."
            },
            {
                category: "Memória & Padrões",
                question: "Se TERRA = 5, PLANETA = 7, UNIVERSO = 8. Qual o valor da palavra GALÁXIA?",
                visual: null,
                options: ["6", "7", "8", "9"],
                correct: 1,
                explanation: "O valor equivale exatamente ao número de letras contidas na palavra: G-A-L-Á-X-I-A = 7 letras."
            }
        ];

        // --- STATE VARIABLES ---
        let currentQuestionIndex = 0;
        let selectedOption = null;
        let userAnswers = [];
        let quizStartTime = null;
        let timerInterval = null;
        let checkPaymentInterval = null;
        let currentPaymentId = null;

        // --- QUIZ FUNCTIONS ---
        function startQuiz() {
            document.getElementById('stepIntro').classList.add('hidden');
            document.getElementById('stepQuiz').classList.remove('hidden');
            document.getElementById('quizTimerNav').classList.remove('hidden');
            document.getElementById('quizTimerNav').classList.add('flex');

            quizStartTime = Date.now();
            startTimer();
            loadQuestion();
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                const seconds = Math.floor((Date.now() - quizStartTime) / 1000);
                const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                document.getElementById('timerText').innerText = `${mins}:${secs}`;
            }, 1000);
        }

        function loadQuestion() {
            const q = questions[currentQuestionIndex];
            selectedOption = null;

            document.getElementById('currentQuestionNum').innerText = currentQuestionIndex + 1;
            document.getElementById('progressBar').style.width = `${((currentQuestionIndex + 1) / questions.length) * 100}%`;
            document.getElementById('questionCategory').innerText = q.category;
            document.getElementById('questionText').innerText = q.question;

            const visualBox = document.getElementById('questionVisual');
            if (q.visual) {
                visualBox.innerText = q.visual;
                visualBox.classList.remove('hidden');
            } else {
                visualBox.classList.add('hidden');
            }

            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = `option-btn p-4 rounded-xl border text-left font-medium transition-all text-sm flex items-center justify-between border-gray-800 bg-gray-900/60 hover:border-gray-700 text-gray-200`;
                btn.onclick = () => selectOption(idx);
                btn.innerHTML = `
                    <span>${opt}</span>
                    <span class="w-5 h-5 rounded-full border border-gray-700 flex items-center justify-center text-[10px] text-transparent check-icon">
                        <i class="fa-solid fa-check"></i>
                    </span>
                `;
                container.appendChild(btn);
            });

            const btnNext = document.getElementById('btnNext');
            btnNext.disabled = true;
            btnNext.className = "px-6 py-3 bg-gray-800 text-gray-500 font-bold rounded-xl border border-gray-700 cursor-not-allowed transition-all inline-flex items-center gap-2";
        }

        function selectOption(index) {
            selectedOption = index;
            const buttons = document.querySelectorAll('.option-btn');

            buttons.forEach((btn, idx) => {
                if (idx === index) {
                    btn.className = "option-btn p-4 rounded-xl border text-left font-medium transition-all text-sm flex items-center justify-between border-brand-500 bg-brand-500/10 text-white shadow-lg shadow-brand-500/10";
                    btn.querySelector('.check-icon').className = "w-5 h-5 rounded-full bg-brand-500 flex items-center justify-center text-[10px] text-white check-icon";
                } else {
                    btn.className = "option-btn p-4 rounded-xl border text-left font-medium transition-all text-sm flex items-center justify-between border-gray-800 bg-gray-900/60 hover:border-gray-700 text-gray-200";
                    btn.querySelector('.check-icon').className = "w-5 h-5 rounded-full border border-gray-700 flex items-center justify-center text-[10px] text-transparent check-icon";
                }
            });

            const btnNext = document.getElementById('btnNext');
            btnNext.disabled = false;
            btnNext.className = "px-6 py-3 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-brand-500/20 transition-all inline-flex items-center gap-2 cursor-pointer";
        }

        function submitAnswer() {
            if (selectedOption === null) return;

            userAnswers.push(selectedOption);

            if (currentQuestionIndex < questions.length - 1) {
                currentQuestionIndex++;
                loadQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            clearInterval(timerInterval);
            document.getElementById('stepQuiz').classList.add('hidden');
            document.getElementById('stepAnalysis').classList.remove('hidden');

            const statusTexts = [
                "Analisando latência das respostas...",
                "Ajustando pontuação psicométrica...",
                "Conectando com o gateway Asaas..."
            ];
            let step = 0;
            const interval = setInterval(() => {
                step++;
                if (step < statusTexts.length) {
                    document.getElementById('analysisStatusText').innerText = statusTexts[step];
                } else {
                    clearInterval(interval);
                    showPaywall();
                }
            }, 1200);
        }

        // --- ASAAS API & PAYWALL INTEGRATION ---
        async function showPaywall() {
            document.getElementById('stepAnalysis').classList.add('hidden');
            document.getElementById('stepPaywall').classList.remove('hidden');

            // Request PIX from Node.js Backend connected to Asaas
            try {
                const response = await fetch('/api/criar-pix', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (data.success) {
                    currentPaymentId = data.paymentId;

                    // Render QR Code Base64 Image from Asaas
                    const imgEl = document.getElementById('pixQrCodeImg');
                    imgEl.src = `data:image/png;base64,${data.encodedImage}`;
                    imgEl.classList.remove('hidden');
                    document.getElementById('pixLoadingSpinner').classList.add('hidden');

                    // Set Copia e Cola Code
                    document.getElementById('pixCopiaEColaInput').value = data.payload;

                    // Start automatic status checking (Polling)
                    startStatusCheck(data.paymentId);
                } else {
                    document.getElementById('checkingStatusText').innerText = "Erro ao conectar com Asaas: " + (data.message || "Tente novamente.");
                }
            } catch (error) {
                console.error("Erro na comunicação com servidor:", error);
                document.getElementById('checkingStatusText').innerText = "Aguardando servidor de pagamento...";
            }
        }

        function copyPixCode() {
            const input = document.getElementById('pixCopiaEColaInput');
            input.select();
            navigator.clipboard.writeText(input.value);

            const btnText = document.getElementById('btnCopyText');
            btnText.innerText = "Copiado!";
            setTimeout(() => { btnText.innerText = "Copiar"; }, 2500);
        }

        function startStatusCheck(paymentId) {
            if (checkPaymentInterval) clearInterval(checkPaymentInterval);

            checkPaymentInterval = setInterval(async () => {
                try {
                    const res = await fetch(`/api/checar-status/${paymentId}`);
                    const data = await res.json();

                    if (data.pago) {
                        clearInterval(checkPaymentInterval);
                        unlockReport();
                    }
                } catch (e) {
                    console.error("Aguardando confirmação...", e);
                }
            }, 3000);
        }

        // --- UNLOCK & DISPLAY REPORT ---
        function unlockReport() {
            document.getElementById('stepPaywall').classList.add('hidden');
            document.getElementById('stepReport').classList.remove('hidden');

            // Calculate Score
            let correctCount = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questions[idx].correct) correctCount++;
            });

            // Base IQ Formula: 85 + (correctCount * 5.5) + speedBonus
            const totalTime = (Date.now() - quizStartTime) / 1000;
            const speedBonus = totalTime < 180 ? 5 : 0;
            const calculatedIQ = Math.round(85 + (correctCount * 5.2) + speedBonus);

            document.getElementById('scoreIQ').innerText = calculatedIQ;

            let classification = "Média Populacional";
            let percentile = "50%";
            if (calculatedIQ >= 130) { classification = "Muito Superior / Genialidade"; percentile = "98.5%"; }
            else if (calculatedIQ >= 120) { classification = "Superior"; percentile = "91%"; }
            else if (calculatedIQ >= 110) { classification = "Acima da Média"; percentile = "75%"; }
            else if (calculatedIQ >= 90) { classification = "Média Normal"; percentile = "50%"; }
            else { classification = "Abaixo da Média"; percentile = "25%"; }

            document.getElementById('scoreClassification').innerText = `Classificação: ${classification}`;
            document.getElementById('scorePercentile').innerText = percentile;

            // Render Gauss Curve
            drawBellCurve(calculatedIQ);

            // Render Explanations
            renderExplanations();
        }

        function drawBellCurve(iqScore) {
            const canvas = document.getElementById('bellCurveCanvas');
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.clearRect(0, 0, w, h);

            // Draw Bell Curve Line
            ctx.beginPath();
            ctx.strokeStyle = '#3b82f6';
            ctx.lineWidth = 3;

            for (let x = 0; x < w; x++) {
                const normX = (x / w) * 6 - 3;
                const y = Math.exp(-0.5 * normX * normX) / Math.sqrt(2 * Math.PI);
                const canvasY = h - (y * (h - 40)) - 20;

                if (x === 0) ctx.moveTo(x, canvasY);
                else ctx.lineTo(x, canvasY);
            }
            ctx.stroke();

            // Calculate user position on canvas (IQ range 70 to 130 mapped to canvas width)
            const clampedIQ = Math.min(Math.max(iqScore, 70), 130);
            const userX = ((clampedIQ - 70) / (130 - 70)) * w;

            // Draw Marker Line
            ctx.beginPath();
            ctx.strokeStyle = '#10b981';
            ctx.setLineDash([4, 4]);
            ctx.moveTo(userX, 20);
            ctx.lineTo(userX, h - 20);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw Dot
            ctx.beginPath();
            ctx.fillStyle = '#10b981';
            ctx.arc(userX, 40, 6, 0, Math.PI * 2);
            ctx.fill();

            // Label
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 12px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`Seu QI: ${iqScore}`, userX, 15);
        }

        function renderExplanations() {
            const container = document.getElementById('answersExplanationsContainer');
            container.innerHTML = '';

            questions.forEach((q, idx) => {
                const isCorrect = userAnswers[idx] === q.correct;
                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border ${isCorrect ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-rose-500/30 bg-rose-500/5'} space-y-2`;

                card.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-bold ${isCorrect ? 'text-emerald-400' : 'text-rose-400'} flex items-center gap-1">
                            <i class="fa-solid ${isCorrect ? 'fa-check' : 'fa-xmark'}"></i>
                            Pergunta ${idx + 1}: ${isCorrect ? 'Resposta Correta' : 'Resposta Incorreta'}
                        </span>
                        <span class="text-gray-500">${q.category}</span>
                    </div>
                    <p class="text-sm font-semibold text-gray-200">${q.question}</p>
                    <div class="text-xs text-gray-400 space-y-1 pt-1 border-t border-gray-800">
                        <div>Sua resposta: <span class="text-gray-200 font-medium">${q.options[userAnswers[idx]] || 'Não respondida'}</span></div>
                        <div>Resposta certa: <span class="text-emerald-400 font-medium">${q.options[q.correct]}</span></div>
                        <p class="text-gray-300 italic pt-1">${q.explanation}</p>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // --- CERTIFICATE GENERATOR ---
        function generateCertificate() {
            const name = document.getElementById('certNameInput').value.trim() || 'Participante CogniMatrix';
            const iq = document.getElementById('scoreIQ').innerText;

            const canvas = document.createElement('canvas');
            canvas.width = 1000;
            canvas.height = 700;
            const ctx = canvas.getContext('2d');

            // Background
            ctx.fillStyle = '#0b0f19';
            ctx.fillRect(0, 0, 1000, 700);

            // Gold Border
            ctx.strokeStyle = '#d97706';
            ctx.lineWidth = 10;
            ctx.strokeRect(30, 30, 940, 640);

            // Title
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 36px "Plus Jakarta Sans", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('CERTIFICADO DE DESEMPENHO NEUROCOGNITIVO', 500, 120);

            ctx.fillStyle = '#3b82f6';
            ctx.font = 'bold 18px sans-serif';
            ctx.fillText('PLATAFORMA COGNIMATRIX • AVALIAÇÃO PADRONIZADA 2026', 500, 160);

            // Body
            ctx.fillStyle = '#9ca3af';
            ctx.font = '20px sans-serif';
            ctx.fillText('Certificamos para os devidos fins que', 500, 250);

            ctx.fillStyle = '#fbbf24';
            ctx.font = 'extrabold 38px sans-serif';
            ctx.fillText(name.toUpperCase(), 500, 310);

            ctx.fillStyle = '#e5e7eb';
            ctx.font = '22px sans-serif';
            ctx.fillText(`concluiu o Teste de QI com a pontuação estimada de:`, 500, 380);

            // IQ Score Box
            ctx.fillStyle = '#1e3a8a';
            ctx.fillRect(380, 420, 240, 90);
            ctx.fillStyle = '#60a5fa';
            ctx.font = 'extrabold 52px sans-serif';
            ctx.fillText(`${iq} QI`, 500, 485);

            // Date
            const today = new Date().toLocaleDateString('pt-BR');
            ctx.fillStyle = '#6b7280';
            ctx.font = '16px sans-serif';
            ctx.fillText(`Emitido em: ${today} • Registro de Autenticidade nº ${Math.random().toString(36).substring(2, 10).toUpperCase()}`, 500, 600);

            // Download Trigger
            const link = document.createElement('a');
            link.download = `Certificado_QI_${name.replace(/\s+/g, '_')}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
        }

        // --- SOCIAL SHARING ---
        function getShareText() {
            const iq = document.getElementById('scoreIQ').innerText;
            return `Acabei de fazer o Teste de QI Oficial CogniMatrix e minha pontuação foi de ${iq} pontos! Faça o seu teste você também:`;
        }

        function shareWhatsApp() {
            const text = encodeURIComponent(`${getShareText()} ${window.location.href}`);
            window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
        }

        function shareTelegram() {
            const text = encodeURIComponent(getShareText());
            const url = encodeURIComponent(window.location.href);
            window.open(`https://t.me/share/url?url=${url}&text=${text}`, '_blank');
        }

        function shareTwitter() {
            const text = encodeURIComponent(getShareText());
            const url = encodeURIComponent(window.location.href);
            window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank');
        }

        function copyShareLink() {
            navigator.clipboard.writeText(`${getShareText()} ${window.location.href}`);
            const btn = document.getElementById('btnShareCopyText');
            btn.innerText = "Copiado!";
            setTimeout(() => { btn.innerText = "Copiar Link"; }, 2500);
        }
    </script>
